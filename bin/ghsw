#!/usr/bin/env bash
# ghsw — gh 계정 전환 + (매핑돼 있으면) git 커밋 신원 동시 전환.
#   ghsw               대화형 선택 (fzf 있으면 fuzzy, 없으면 번호 메뉴)
#   ghsw <번호>        목록 N번째로 바로 전환 (예: ghsw 2)
#   ghsw <계정명>      그 계정으로 바로 전환 (예: ghsw smnoh_gsenc)
#   ghsw <계정:태그>   같은 계정의 특정 신원으로 전환 (예: ghsw smnoh_gsenc:personal)
#   ghsw --local ...   이 전환의 git 신원을 repo-local로 적용(기본은 --global)
#   ghsw --edit        신원 매핑 파일(~/.config/orcli/ghsw.conf) 편집
#   ghsw --emit-env .. 셸 래퍼용 — stdout엔 export/unset GH_TOKEN 줄만, 사람용 출력은 stderr
#   ghsw -h|--help     도움말
# 신원 매핑은 ~/.config/orcli/ghsw.conf 에서 읽는다 —  gh계정[:태그] | 이름 | 이메일 | [signingkey] | [token]
# 한 계정에 신원이 여러 개면 계정명 뒤에 :태그 를 붙여 줄을 나눈다.
# token 칼럼(keychain:<서비스명> | file:<경로>)이 있는 프로필은 전환 시 GH_TOKEN을 export — 셸 래퍼(--emit-env) 필요.
set -euo pipefail

# --emit-env 면 stdout이 eval 채널(파이프)이므로 컬러 판정은 stderr 기준
emit=0
for a in "$@"; do [ "$a" = --emit-env ] && emit=1; done

# 환경의 GH_TOKEN/GITHUB_TOKEN은 gh가 키링보다 우선해 계정 전환을 막는다 — 이 프로세스에선 걷어내고
# (env -u 와 동일, 부모 셸엔 영향 없음) 아래에서 경고만 한다.
had_env_token=0
if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then had_env_token=1; unset GH_TOKEN GITHUB_TOKEN; fi

# 컬러 — 출력 대상이 터미널일 때만(파이프·리다이렉트 시 plain)
if [ -t "$((emit ? 2 : 1))" ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
  CYAN=$'\033[36m'; YEL=$'\033[33m'; GRN=$'\033[32m'; MAG=$'\033[35m'
else
  BOLD=; DIM=; RST=; CYAN=; YEL=; GRN=; MAG=
fi

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/orcli/ghsw.conf"

# 앞뒤 공백 제거
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

# 계정 → 매핑 줄(전체) 찾기.  없으면 1 반환.
identity_for() {
  local acct="$1" line f1
  [ -f "$CONF" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    f1=$(trim "${line%%|*}")
    [ "$f1" = "$acct" ] && { printf '%s' "$line"; return 0; }
  done < "$CONF"
  return 1
}

# 매핑 파일 생성/편집
edit_config() {
  mkdir -p "$(dirname "$CONF")"
  if [ ! -f "$CONF" ]; then
    cat > "$CONF" <<'EOF'
# ghsw 신원 매핑 — gh 계정을 바꿀 때 git user.name/email 을 함께 설정한다.
# 형식:   gh계정[:태그] | 이름 | 이메일 | signingkey(선택) | token(선택)
# 줄 앞 #은 주석. 예:
# smnoh_gsenc | Chris Noh | platdev@gsenc.com
# biyott      | biyott    | 12345678+biyott@users.noreply.github.com
#
# 한 계정에 신원 여러 개 — 계정명 뒤에 :태그 로 줄을 나눈다. 위에서부터 순서대로 목록에 뜨고,
# 태그 없이 'ghsw smnoh_gsenc' 하면 그 계정의 첫 줄이 쓰인다.
# smnoh_gsenc:work     | Chris Noh | platdev@gsenc.com
# smnoh_gsenc:personal | Chris Noh | chris@example.com
#
# token 칼럼 — 그 프로필로 전환할 때 GH_TOKEN(PAT)을 같이 export. signingkey 칸은 비워 둔다.
#   keychain:<서비스명>  macOS 키체인 (`security find-generic-password -s <서비스명> -w`) — 권장
#   file:<경로>          평문 파일 첫 줄 (~ 와 $HOME 전개). 간단하지만 chmod 600 필수,
#                        git repo·셸 시작 파일(.zshenv 등) 밖에 두고 source 하지 말 것 — ghsw가 직접 읽는다.
# 셸 래퍼(install.sh가 안내)가 있어야 부모 셸에 적용된다. token 없는 프로필로 가면 GH_TOKEN을 unset.
# smnoh_gsenc:admin | Chris Noh | platdev@gsenc.com | | keychain:orcli-ghsw-smnoh_gsenc
# smnoh_gsenc:admin | Chris Noh | platdev@gsenc.com | | file:~/.config/orcli/tokens/smnoh_gsenc.admin
EOF
  fi
  "${EDITOR:-vi}" "$CONF"
}

# 신원 적용 — 매핑 없으면 안내만.  scope: global(기본) | local
apply_identity() {
  local acct="$1" line name email key
  if ! line=$(identity_for "$acct"); then
    printf '   %s신원 매핑 없음%s — %sghsw --edit%s 로 %s 추가\n' "$DIM" "$RST" "$YEL" "$RST" "$acct"
    return 0
  fi
  IFS='|' read -r _ name email key _ <<<"$line"
  name=$(trim "$name"); email=$(trim "$email"); key=$(trim "${key:-}")
  if [ "$scope" = local ] && ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "  --local 인데 git repo 안이 아님 — 신원 적용 건너뜀" >&2
    return 0
  fi
  git config "--$scope" user.name "$name"
  git config "--$scope" user.email "$email"
  [ -n "$key" ] && git config "--$scope" user.signingkey "$key"
  printf '   %sgit 신원%s → %s%s%s <%s> %s(%s)%s\n' "$BOLD" "$RST" "$BOLD" "$name" "$RST" "$email" "$DIM" "$scope" "$RST"
}

# 프로필의 token 칼럼 원문 (없으면 빈 문자열)
token_src() {
  local line src
  line=$(identity_for "$1") || return 0
  IFS='|' read -r _ _ _ _ src <<<"$line"
  trim "${src:-}"
}

# file:<경로> 토큰 읽기 — 첫 줄만, 값은 stdout(호출부가 캡처)으로만. 경고·사유는 stderr.
# 못 읽으면(없음·빈 파일·권한) 1. 모드가 600/400이 아니거나 소유자가 내가 아니면 경고만 하고 계속 쓴다.
read_token_file() {
  local p="$1" st mode owner tok
  case "$p" in
    '~'|'~/'*) p="$HOME${p#\~}" ;;
    '$HOME'*)  p="$HOME${p#\$HOME}" ;;
  esac
  if [ ! -f "$p" ] || [ ! -r "$p" ]; then
    printf '   %s⚠ 토큰 파일 없음/읽기 불가: %s%s\n' "$YEL" "$p" "$RST" >&2; return 1
  fi
  st=$(stat -c '%a %u' "$p" 2>/dev/null || stat -f '%Lp %u' "$p" 2>/dev/null) || st=""
  mode=${st%% *}; owner=${st##* }
  if [ -n "$st" ] && { { [ "$mode" != 600 ] && [ "$mode" != 400 ]; } || [ "$owner" != "$(id -u)" ]; }; then
    printf '   %s⚠ 토큰 파일 권한/소유자 이상(%s, uid %s) — chmod 600 %s%s\n' "$YEL" "$mode" "$owner" "$p" "$RST" >&2
  fi
  tok=$(head -n 1 "$p" 2>/dev/null) || tok=""
  tok=${tok%$'\r'}; tok=$(trim "$tok")
  if [ -z "$tok" ]; then
    printf '   %s⚠ 토큰 파일이 비어 있음: %s%s\n' "$YEL" "$p" "$RST" >&2; return 1
  fi
  printf '%s' "$tok"
}

# 토큰을 읽어 검증하고 export 줄을 eval 채널(fd 3)로만 내보낸다 — 터미널엔 값을 절대 찍지 않는다.
# 읽기 실패·401이면 unset을 내보내 이전 프로필의 토큰이 남지 않게 한다.
emit_token() {
  local acct="$1" src="$2" tok="" out
  case "$src" in
    keychain:?*) tok=$(security find-generic-password -s "${src#keychain:}" -w 2>/dev/null) || tok="" ;;
    file:?*)     tok=$(read_token_file "${src#file:}") || tok="" ;;
    *) printf '   %s⚠ token 소스 미지원: %s (keychain:<서비스명> | file:<경로>)%s\n' "$YEL" "$src" "$RST" >&2 ;;
  esac
  if [ -z "$tok" ]; then
    printf '   %s⚠ %s 토큰을 못 읽음 — GH_TOKEN unset, gh는 키링 계정을 쓴다%s\n' "$YEL" "$src" "$RST" >&2
    printf 'unset GH_TOKEN GITHUB_TOKEN\n' >&3
    return 0
  fi
  if out=$(GH_TOKEN="$tok" gh api user -q .login 2>&1); then
    [ "$out" = "$acct" ] || printf '   %s⚠ 토큰 소유자(%s) ≠ 계정(%s)%s\n' "$YEL" "$out" "$acct" "$RST" >&2
  elif grep -qE 'HTTP 401|Bad credentials' <<<"$out"; then
    printf '   %s⚠ %s 토큰 401 — token expired? 갱신 후 키체인 값 교체 · GH_TOKEN unset%s\n' "$YEL" "$acct" "$RST" >&2
    printf 'unset GH_TOKEN GITHUB_TOKEN\n' >&3
    return 0
  else
    printf '   %s⚠ 토큰 검증 못함(네트워크?) — 그대로 export%s\n' "$YEL" "$RST" >&2
  fi
  printf 'export GH_TOKEN=%q\n' "$tok" >&3
  printf '   %sGH_TOKEN%s → %s %s(%s)%s\n' "$BOLD" "$RST" "$acct" "$DIM" "${src%%:*}" "$RST"
}

# 'acct:tag' 에서 gh 계정 부분만
acct_of() { printf '%s' "${1%%:*}"; }

# 프로필 목록 — 번호=시안, 활성엔 초록 ● 현재, 매핑 있으면 dim → 이메일
# 같은 계정에 신원이 여러 개면 gh 활성 계정만으로는 구분이 안 되므로 현재 git 이메일까지 본다.
list_profiles() {
  local i=1 p line email tag
  for p in "${profiles[@]}"; do
    tag=""; email=""
    if line=$(identity_for "$p"); then
      IFS='|' read -r _ _ email _ <<<"$line"; email=$(trim "${email:-}")
      tag=$(printf '  %s→ %s%s' "$DIM" "$email" "$RST")
    fi
    if [ "$(acct_of "$p")" = "$active" ] && { [ -z "$email" ] || [ "$email" = "$cur_email" ]; }; then
      printf '     %s%d)%s %s%s%s  %s● 현재%s%s\n' "$CYAN" "$i" "$RST" "$BOLD" "$p" "$RST" "$GRN" "$RST" "$tag"
    else
      printf '     %s%d)%s %s%s\n' "$CYAN" "$i" "$RST" "$p" "$tag"
    fi
    i=$((i + 1))
  done
}

# 구분선 (dim, 34칸)
hr() { printf '   %s──────────────────────────────────%s\n' "$DIM" "$RST"; }

usage() {
  printf '\n'
  printf '   %s%sghsw%s %s<명령>%s\n\n' "$BOLD" "$MAG" "$RST" "$CYAN" "$RST"
  printf '   %s사용법%s\n' "$BOLD" "$RST"
  hr
  printf '     %sghsw%s              대화형 선택기로 전환\n' "$YEL" "$RST"
  printf '     %sghsw %s<번호>%s       목록 번호로 바로 전환\n' "$YEL" "$CYAN" "$RST"
  printf '     %sghsw %s<이름>%s       계정명으로 바로 전환\n' "$YEL" "$CYAN" "$RST"
  printf '     %sghsw %s<계정:태그>%s  같은 계정의 다른 신원으로 전환\n' "$YEL" "$CYAN" "$RST"
  printf '     %sghsw --local%s      git 신원을 이 repo에만 적용 %s(기본: --global)%s\n' "$YEL" "$RST" "$DIM" "$RST"
  printf '     %sghsw --edit%s       신원 매핑 파일 편집\n' "$YEL" "$RST"
  printf '     %sghsw --emit-env%s   셸 래퍼용: GH_TOKEN export/unset 줄을 stdout으로 %s(token 칼럼 프로필)%s\n' "$YEL" "$RST" "$DIM" "$RST"
  printf '     %sghsw -h%s|%shelp%s      이 도움말\n' "$YEL" "$RST" "$YEL" "$RST"
  if [ "${#profiles[@]}" -gt 0 ]; then
    printf '\n   %s계정%s   %s(전환 시 매핑된 git 신원도 함께 설정)%s\n' "$BOLD" "$RST" "$DIM" "$RST"
    hr
    list_profiles
  fi
  printf '\n'
  hr
  printf '   %sgh auth switch + git config 래퍼 · 매핑: %s%s\n\n' "$DIM" "$CONF" "$RST"
}

# ── 인자 파싱: 플래그 + 위치인자 ────────────────────────────
scope=global
do_edit=0
posargs=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help|help) HELP=1 ;;
    --local)  scope=local ;;
    --global) scope=global ;;
    --edit|--config) do_edit=1 ;;
    --emit-env) emit=1 ;;
    --) shift; while [ "$#" -gt 0 ]; do posargs+=("$1"); shift; done; break ;;
    -*) echo "알 수 없는 옵션: $1" >&2; exit 1 ;;
    *)  posargs+=("$1") ;;
  esac
  shift
done

# --emit-env: 원래 stdout을 fd 3(eval 채널)으로 빼두고, 이후 모든 사람용 출력은 stderr로
[ "$emit" = 1 ] && exec 3>&1 1>&2

[ "${do_edit:-0}" = 1 ] && { edit_config; exit 0; }

# bash 3.2(macOS 기본) 호환 — mapfile 없이 read 루프로 배열 채움
accounts=()
while IFS= read -r line; do accounts+=("$line"); done < <(gh auth status 2>&1 | grep -oE 'account [A-Za-z0-9_-]+' | awk '{print $2}' | sort -u)
active=$(gh auth status 2>&1 | grep -B2 'Active account: true' | grep -oE 'account [A-Za-z0-9_-]+' | awk '{print $2}' | head -1 || true)
cur_email=$(git config user.email 2>/dev/null || true)

# 프로필 = 전환 단위. conf에 'acct' 또는 'acct:태그' 줄이 있으면 줄마다 하나씩,
# 매핑이 아예 없는 계정은 계정명 그대로 한 개.
# bash 3.2 + set -u — 빈 배열 "${accounts[@]}" 전개가 죽으므로 루프를 감싼다
profiles=()
if [ "${#accounts[@]}" -gt 0 ]; then
  for a in "${accounts[@]}"; do
    found=0
    if [ -f "$CONF" ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|\#*) continue ;; esac
        key=$(trim "${line%%|*}")
        [ "${key%%:*}" = "$a" ] && { profiles+=("$key"); found=1; }
      done < "$CONF"
    fi
    [ "$found" = 0 ] && profiles+=("$a")
  done
fi

# 도움말은 로그인 여부와 무관하게 보여준다 — 계정 0개면 usage가 목록만 건너뜀
[ "${HELP:-0}" = 1 ] && { usage; exit 0; }

if [ "${#accounts[@]}" -eq 0 ]; then
  echo "gh 로그인 계정 없음. 먼저 'gh auth login'." >&2
  exit 1
fi

# 래퍼 없이 실행했을 때만 경고 — 래퍼(--emit-env)는 아래에서 export/unset 으로 부모 env를 바로잡는다
if [ "$had_env_token" = 1 ] && [ "$emit" = 0 ]; then
  printf '   %s⚠ GH_TOKEN/GITHUB_TOKEN 이 환경에 설정됨%s — gh는 키링보다 이 값을 우선한다.\n' "$YEL" "$RST" >&2
  printf '     ghsw는 키링 기준으로 전환하지만 이 셸의 gh는 %sunset GH_TOKEN GITHUB_TOKEN%s 전까지 계속 덮어쓴다 (셸 래퍼: install.sh 참고)\n' "$BOLD" "$RST" >&2
fi

# 인자 해석: 번호 · 'acct:태그' · 계정명(그 계정의 첫 프로필)
resolve_arg() {
  local arg="$1" p
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    local i=$((arg - 1))
    if [ "$i" -lt 0 ] || [ "$i" -ge "${#profiles[@]}" ]; then
      echo "범위 밖 번호: $arg (1~${#profiles[@]})" >&2; exit 1
    fi
    printf '%s' "${profiles[$i]}"
    return
  fi
  for p in "${profiles[@]}"; do
    [ "$p" = "$arg" ] && { printf '%s' "$p"; return; }
  done
  for p in "${profiles[@]}"; do
    [ "$(acct_of "$p")" = "$arg" ] && { printf '%s' "$p"; return; }
  done
  echo "그런 계정 없음: $arg" >&2
  echo "가능: ${profiles[*]}" >&2
  exit 1
}

chosen=""
if [ "${#posargs[@]}" -ge 1 ]; then
  chosen=$(resolve_arg "${posargs[0]}")
else
  # 대화형 — 활성 신원엔 (현재) 표시. 라벨 첫 필드가 프로필 키(공백 없음).
  labels=()
  for p in "${profiles[@]}"; do
    email=""
    if pline=$(identity_for "$p"); then
      IFS='|' read -r _ _ email _ <<<"$pline"; email=$(trim "${email:-}")
    fi
    label="$p"
    [ "$(acct_of "$p")" = "$active" ] && { [ -z "$email" ] || [ "$email" = "$cur_email" ]; } && label="$label (현재)"
    [ -n "$email" ] && label="$label → $email"
    labels+=("$label")
  done
  if command -v fzf >/dev/null 2>&1; then
    chosen=$(printf '%s\n' "${labels[@]}" | fzf --prompt="gh 계정 전환 > " --height=40% | awk '{print $1}')
  else
    echo "gh 계정 선택:"
    select label in "${labels[@]}"; do
      [ -n "${label:-}" ] && chosen=$(awk '{print $1}' <<<"$label") && break
    done
  fi
fi

[ -z "${chosen:-}" ] && { echo "선택 취소." >&2; exit 1; }

chosen_acct=$(acct_of "$chosen")
if [ "$chosen_acct" = "$active" ]; then
  echo "이미 활성: $chosen_acct"
else
  gh auth switch --user "$chosen_acct"
fi
apply_identity "$chosen"

# 토큰 — 칼럼 있으면 export, 없으면 unset. 평문 실행(래퍼 없음)이면 부모 env를 못 바꾸므로 안내만.
src=$(token_src "$chosen")
if [ "$emit" = 1 ]; then
  if [ -n "$src" ]; then
    emit_token "$chosen_acct" "$src"
  else
    printf 'unset GH_TOKEN GITHUB_TOKEN\n' >&3
  fi
elif [ -n "$src" ]; then
  printf '   %sGH_TOKEN 프로필%s — 부모 셸엔 래퍼로만 적용됨: %seval "$(ghsw --emit-env %s)"%s\n' "$BOLD" "$RST" "$YEL" "$chosen" "$RST"
fi
