#!/usr/bin/env bash
# gitundo — 자주 하는 git "되돌리기"를 안전한 메뉴로 모아둔다.
#   gitundo            현재 상태를 보여주고 되돌리기 항목을 고른다
#   gitundo -h|--help  도움말
# 위험한 항목(변경 삭제)은 yes 를 입력해야 실행된다.  대부분은 reflog 로 되살릴 수 있다.
set -euo pipefail

if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
  CYAN=$'\033[36m'; YEL=$'\033[33m'; GRN=$'\033[32m'; MAG=$'\033[35m'; RED=$'\033[31m'
else
  BOLD=; DIM=; RST=; CYAN=; YEL=; GRN=; MAG=; RED=
fi
hr() { printf '   %s──────────────────────────────────%s\n' "$DIM" "$RST"; }

case "${1:-}" in
  -h|--help|help)
    printf '\n   %s%sgitundo%s — git 되돌리기 메뉴\n\n' "$BOLD" "$MAG" "$RST"
    printf '   변경을 지우는 항목은 %syes%s 확인을 받고, 실행 전 무엇을 할지 알려준다.\n' "$YEL" "$RST"
    printf '   거의 모든 되돌리기는 %sgit reflog%s 로 복구 가능하다.\n\n' "$DIM" "$RST"
    exit 0 ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "git repo 안이 아님." >&2; exit 1; }

confirm() {  # $1=설명
  printf '   %s%s%s\n' "$YEL" "$1" "$RST"
  printf '   실행하려면 %syes%s 입력: ' "$YEL" "$RST"; read -r a
  [ "$a" = "yes" ]
}

# 현재 상태 요약
printf '\n   %s현재 상태%s\n' "$BOLD" "$RST"; hr
git -c color.ui=always status -sb | sed 's/^/     /'
last="$(git log -1 --oneline 2>/dev/null || true)"
[ -n "$last" ] && printf '   %s마지막 커밋:%s %s\n' "$DIM" "$RST" "$last"
printf '\n'

opts=(
  "마지막 커밋 취소 — 변경은 그대로 둠 (soft reset)"
  "마지막 커밋 취소 — 스테이징도 해제 (mixed reset)"
  "마지막 커밋 취소 — 변경도 삭제 ⚠ (hard reset)"
  "스테이징만 해제 (git reset)"
  "워킹트리 변경 폐기 ⚠ (추적 파일 되돌림)"
  "마지막 커밋 메시지/내용 수정 (commit --amend)"
  "진행 중 머지 중단 (merge --abort)"
  "진행 중 리베이스 중단 (rebase --abort)"
  "reflog 보기 — 잃어버린 커밋 되살리기"
)

choose() {
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${opts[@]}" | fzf --prompt="되돌리기 > " --height=45% || true
  else
    local s PS3="번호> "
    select s in "${opts[@]}"; do [ -n "${s:-}" ] && { printf '%s' "$s"; return; }; done
  fi
}

sel="$(choose)"
[ -z "${sel:-}" ] && { echo "취소."; exit 0; }

case "$sel" in
  "마지막 커밋 취소 — 변경은 그대로 둠"*)
    git reset --soft HEAD~1 && printf '   %s✓%s soft reset — 변경은 스테이징에 남음\n' "$GRN" "$RST" ;;
  "마지막 커밋 취소 — 스테이징도 해제"*)
    git reset --mixed HEAD~1 && printf '   %s✓%s mixed reset — 변경은 워킹트리에 남음\n' "$GRN" "$RST" ;;
  "마지막 커밋 취소 — 변경도 삭제"*)
    confirm "마지막 커밋과 그 변경을 모두 버립니다 (reflog 로만 복구 가능)." \
      && git reset --hard HEAD~1 && printf '   %s✓%s hard reset 완료\n' "$GRN" "$RST" || echo "취소." ;;
  "스테이징만 해제"*)
    git reset && printf '   %s✓%s 스테이징 해제됨\n' "$GRN" "$RST" ;;
  "워킹트리 변경 폐기"*)
    confirm "추적 중인 파일의 커밋되지 않은 변경을 모두 버립니다." \
      && { git checkout -- . && printf '   %s✓%s 워킹트리 변경 폐기됨\n' "$GRN" "$RST"; } || echo "취소." ;;
  "마지막 커밋 메시지/내용 수정"*)
    git commit --amend ;;
  "진행 중 머지 중단"*)
    git merge --abort && printf '   %s✓%s 머지 중단됨\n' "$GRN" "$RST" ;;
  "진행 중 리베이스 중단"*)
    git rebase --abort && printf '   %s✓%s 리베이스 중단됨\n' "$GRN" "$RST" ;;
  "reflog 보기"*)
    printf '   %s최근 20개 — 되살리려면:%s git reset --hard <해시>\n\n' "$DIM" "$RST"
    git -c color.ui=always reflog -20 | sed 's/^/     /' ;;
  *) echo "알 수 없는 선택." >&2; exit 1 ;;
esac
