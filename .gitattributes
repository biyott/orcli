# Default: let git detect text files and normalize to LF in the repo.
# Working-tree EOL follows the OS/core.autocrlf for ordinary docs.
* text=auto

# Shell scripts must stay LF on every OS (CRLF breaks `set -o pipefail`,
# shebangs, heredocs). Covers WSL, Git Bash, macOS, Linux.
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf
bin/*     text eol=lf
lib/**    text eol=lf
.gitattributes text eol=lf

# Windows-native scripts need CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Plain docs/config: LF everywhere for stable diffs.
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
.gitignore text eol=lf
LICENSE   text eol=lf

# Binary files: never touch.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.gz      binary
